{
  "name": "jackaroo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@jackaroo/web",
    "dev:api": "turbo run dev --filter=@jackaroo/api",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=@jackaroo/game-engine",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "db:generate": "pnpm --filter @jackaroo/api prisma:generate",
    "db:migrate": "pnpm --filter @jackaroo/api prisma:migrate",
    "db:deploy": "pnpm --filter @jackaroo/api prisma:deploy",
    "db:studio": "pnpm --filter @jackaroo/api prisma:studio"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "2.11.12",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "@swc/core"
    ]
  }
}
