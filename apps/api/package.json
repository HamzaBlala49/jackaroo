{
  "name": "@jackaroo/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsc-watch -p tsconfig.json --preserveWatchOutput --onSuccess \"node dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "lint": "eslint ."
  },
  "dependencies": {
    "@jackaroo/game-board": "workspace:*",
    "@jackaroo/game-config": "workspace:*",
    "@jackaroo/game-engine": "workspace:*",
    "@jackaroo/game-types": "workspace:*",
    "@jackaroo/shared-utils": "workspace:*",
    "@nestjs/common": "12.5.1",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@nestjs/platform-socket.io": "12.5.1",
    "@nestjs/websockets": "12.5.1",
    "@prisma/client": "6.19.3",
    "@socket.io/redis-adapter": "8.3.0",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.7",
    "@nestjs/jwt": "12.0.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "7.2.1",
    "prisma": "6.19.3",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.2",
    "vitest": "3.2.7",
    "typescript": "5.9.3",
    "tsc-watch": "7.2.0",
    "@swc/core": "1.16.22",
    "unplugin-swc": "2.0.0",
    "eslint": "9.39.5",
    "@jackaroo/eslint-config": "workspace:*"
  }
}
