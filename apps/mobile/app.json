{
  "expo": {
    "name": "جيكارو",
    "slug": "jackaroo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#5f1212",
    "splash": {
      "backgroundColor": "#5f1212",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.jackaroo.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "يستخدم جيكارو الشبكة المحلية للعب مع أصدقائك على نفس الواي فاي.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jackaroo.mobile",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "supportsRTL": true,
      "eas": {
        "projectId": "183395fb-22c9-49f4-b1b9-7f4d58a45c19"
      }
    },
    "owner": "hamza-omar"
  }
}
