{
  "name": "@jackaroo/game-board",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "lint": "eslint ."
  },
  "dependencies": {
    "@jackaroo/game-config": "workspace:*",
    "@jackaroo/game-types": "workspace:*"
  },
  "devDependencies": {
    "vitest": "3.2.7",
    "eslint": "9.39.5",
    "@jackaroo/eslint-config": "workspace:*"
  }
}
