# ─────────────────────────────────────────────────────────────
# Jackaroo Online — environment example
# Copy to .env (never commit .env)
# ─────────────────────────────────────────────────────────────

# ── API ──────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# PostgreSQL
DATABASE_URL=postgresql://jackaroo@localhost:5433/jackaroo?schema=public

# Redis (optional locally; required in production)
REDIS_URL=redis://localhost:6379

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_DAYS=30
COOKIE_SECURE=false

# ── Web ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Prisma (used by CLI) ─────────────────────────────────────
# same as DATABASE_URL above
